# ============================================================
# Asset Console Enterprise Edition - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Server Configuration ───────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Database & Persistent Storage ──────────────────────────
# On hosting platforms (e.g. Render / Railway with Persistent Volume),
# set this to the mount path of your disk (e.g., /data/assets.db).
# If left empty, defaults to ./assets.db in the application directory.
DB_PATH=assets.db

# Directory for uploaded asset photos (e.g., /data/uploads or ./uploads)
UPLOADS_DIR=uploads

# ── Security & Authentication ──────────────────────────────
# Secret key used for session cookie signing (generate a strong random string)
SESSION_SECRET=your_long_random_session_secret_change_me_in_production

# ── Google OAuth 2.0 ───────────────────────────────────────
# Get these credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional explicit callback URL (default: ${OAUTH_BASE_URL}/api/auth/google/callback)
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Production Base URL of backend for OAuth redirect callback
# e.g., https://asset-console-backend.onrender.com or https://api.yourdomain.com
OAUTH_BASE_URL=http://localhost:8080

# ── Frontend & Cloudflare Integration ──────────────────────
# Frontend URL when hosted separately on Cloudflare Pages
# e.g., https://asset-console.pages.dev
FRONTEND_URL=http://localhost:8080

# CORS Allowed Origin (* for open or comma-separated list of origins)
CORS_ORIGIN=*
